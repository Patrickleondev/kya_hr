{
 "name": "Salarie KYA",
 "module": "KYA HR",
 "doctype": "DocType",
 "custom": 0,
 "engine": "InnoDB",
 "autoname": "field:matricule",
 "title_field": "nom_complet",
 "search_fields": "matricule, nom, prenoms, poste_occupe",
 "sort_field": "matricule",
 "sort_order": "ASC",
 "track_changes": 1,
 "allow_rename": 1,
 "image_field": "photo",
 "description": "Registre du personnel KYA (base RH). Système autonome : n'utilise PAS la paie ERPNext. La RH peut compléter/personnaliser les champs.",
 "fields": [
  {"fieldname": "sb_identite", "fieldtype": "Section Break", "label": "Identité"},
  {"fieldname": "matricule", "label": "Matricule", "fieldtype": "Data", "reqd": 1, "unique": 1, "in_list_view": 1, "in_standard_filter": 1, "columns": 1},
  {"fieldname": "nom", "label": "Nom", "fieldtype": "Data", "reqd": 1, "in_list_view": 1, "columns": 2},
  {"fieldname": "prenoms", "label": "Prénoms", "fieldtype": "Data", "in_list_view": 1, "columns": 2},
  {"fieldname": "nom_complet", "label": "Nom & Prénoms", "fieldtype": "Data", "read_only": 1, "hidden": 1},
  {"fieldname": "sexe", "label": "Sexe", "fieldtype": "Select", "options": "\nM\nF", "in_standard_filter": 1, "in_list_view": 1, "columns": 1},
  {"fieldname": "numero_assurance_sociale", "label": "N° Assurance Sociale", "fieldtype": "Data"},
  {"fieldname": "nationalite", "label": "Nationalité", "fieldtype": "Select", "options": "\nTG\nGH\nBJ\nCI\nFR\nAutre", "default": "TG"},
  {"fieldname": "statut_matrimonial", "label": "Statut matrimonial", "fieldtype": "Select", "options": "\nCELIBATAIRE\nMARIE\nMARIEE\nDIVORCE\nDIVORCEE\nVEUF\nVEUVE"},
  {"fieldname": "nombre_enfants", "label": "Nombre d'enfants", "fieldtype": "Int", "default": "0"},
  {"fieldname": "cb_identite", "fieldtype": "Column Break"},
  {"fieldname": "date_naissance", "label": "Date de naissance", "fieldtype": "Date"},
  {"fieldname": "age", "label": "Âge", "fieldtype": "Int", "read_only": 1, "description": "Calculé à partir de la date de naissance."},
  {"fieldname": "contact_telephonique", "label": "Contact téléphonique", "fieldtype": "Data"},
  {"fieldname": "photo", "label": "Photo d'identité", "fieldtype": "Attach Image"},
  {"fieldname": "carte_identite", "label": "Carte d'identité (scan)", "fieldtype": "Attach", "description": "Pièce d'identité / CNI de l'employé."},

  {"fieldname": "sb_poste", "fieldtype": "Section Break", "label": "Poste & contrat"},
  {"fieldname": "poste_occupe", "label": "Poste occupé", "fieldtype": "Data", "in_list_view": 1, "columns": 2},
  {"fieldname": "departement", "label": "Département de rattachement", "fieldtype": "Link", "options": "Departement KYA", "in_standard_filter": 1, "in_list_view": 1, "columns": 1},
  {"fieldname": "qualification", "label": "Qualification", "fieldtype": "Data"},
  {"fieldname": "niveau_etudes", "label": "Niveau d'études", "fieldtype": "Select", "options": "\nSans diplôme\nCEPD/BEPC\nCAP/BEP\nBaccalauréat\nBac\nBAC+2/BTS/DUT\nLicence\nMaster\nIngénieur\nDoctorat\nPostdoc", "in_standard_filter": 1},
  {"fieldname": "cb_poste", "fieldtype": "Column Break"},
  {"fieldname": "type_contrat", "label": "Type de contrat", "fieldtype": "Select", "options": "\nCDI\nCDD\nStagiaire\nPrestataire\nIntérim", "in_standard_filter": 1, "in_list_view": 1, "columns": 1},
  {"fieldname": "categorie", "label": "Catégorie", "fieldtype": "Select", "options": "\nC\nAM\nAE", "in_standard_filter": 1, "description": "C = Cadre · AM = Agent de Maîtrise · AE = Agent d'Exécution"},
  {"fieldname": "classe_echelon", "label": "Classe & échelon", "fieldtype": "Data"},
  {"fieldname": "type_travail", "label": "Type de travail", "fieldtype": "Select", "options": "\nPrésentiel\nTélétravail\nHybride", "default": "Présentiel", "in_standard_filter": 1},
  {"fieldname": "salaire_base", "label": "Salaire de base", "fieldtype": "Currency", "description": "Sert aux calculs maison (ancienneté, indemnités). Aucune paie ERPNext."},

  {"fieldname": "sb_carriere", "fieldtype": "Section Break", "label": "Carrière & retraite"},
  {"fieldname": "date_embauche", "label": "Date d'embauche", "fieldtype": "Date", "in_list_view": 1, "columns": 1},
  {"fieldname": "anciennete_annees", "label": "Ancienneté (années)", "fieldtype": "Float", "read_only": 1, "precision": "1", "description": "De l'embauche à aujourd'hui (ou à la débauche)."},
  {"fieldname": "date_immatriculation_cnss", "label": "Date d'immatriculation CNSS", "fieldtype": "Date"},
  {"fieldname": "date_admission_retraite", "label": "Date d'admission à la retraite", "fieldtype": "Date", "read_only": 1, "description": "Calculée : date de naissance + 60 ans."},
  {"fieldname": "cb_carriere", "fieldtype": "Column Break"},
  {"fieldname": "statut_emploi", "label": "Statut", "fieldtype": "Select", "options": "Actif\nSorti\nRetraité", "read_only": 1, "default": "Actif", "in_standard_filter": 1, "in_list_view": 1, "columns": 1},
  {"fieldname": "date_debauchage", "label": "Date de débauchage / sortie", "fieldtype": "Date"},
  {"fieldname": "motif_debauchage", "label": "Motif de débauchage", "fieldtype": "Select", "options": "\nDémission\nLicenciement\nFin de contrat\nRetraite\nDécès\nRupture conventionnelle\nAbandon de poste", "in_standard_filter": 1},

  {"fieldname": "sb_divers", "fieldtype": "Section Break", "label": "Divers"},
  {"fieldname": "observation", "label": "Observation", "fieldtype": "Small Text"},
  {"fieldname": "employee_link", "label": "Fiche Employé liée (ERPNext)", "fieldtype": "Link", "options": "Employee", "description": "Lien optionnel vers la fiche Employee HRMS (congés, contrats…)."}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1, "share": 1, "print": 1, "email": 1},
  {"role": "Responsable RH", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1, "print": 1, "email": 1, "share": 1},
  {"role": "HR Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1, "print": 1},
  {"role": "HR User", "read": 1, "write": 1, "create": 1, "export": 1, "report": 1, "print": 1},
  {"role": "Assistant(e) RH", "read": 1, "write": 1, "create": 1, "export": 1, "report": 1, "print": 1},
  {"role": "Directeur Général", "read": 1, "report": 1, "export": 1, "print": 1},
  {"role": "DGA", "read": 1, "report": 1, "export": 1}
 ]
}
