{
 "name": "Planning Conge Equipe",
 "module": "KYA HR",
 "doctype": "DocType",
 "is_submittable": 1,
 "custom": 1,
 "autoname": "format:PLEQ-{YYYY}-{#####}",
 "title_field": "titre",
 "search_fields": "chef_equipe_name, annee, statut",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "section_chef",
   "label": "Équipe & Année",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "equipe",
   "label": "Équipe",
   "fieldtype": "Link",
   "options": "Equipe KYA",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "chef_equipe",
   "label": "Chef d'Équipe",
   "fieldtype": "Link",
   "options": "Employee",
   "fetch_from": "equipe.chef_equipe",
   "read_only": 1
  },
  {
   "fieldname": "chef_equipe_name",
   "label": "Nom du Chef",
   "fieldtype": "Data",
   "fetch_from": "equipe.chef_equipe_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "col_chef",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "departement",
   "label": "Département",
   "fieldtype": "Link",
   "options": "Department",
   "fetch_from": "equipe.departement",
   "read_only": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "annee",
   "label": "Année",
   "fieldtype": "Int",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Année du planning (ex: 2026)"
  },
  {
   "fieldname": "titre",
   "label": "Titre",
   "fieldtype": "Data",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "section_lignes",
   "label": "Périodes de Congé de l'Équipe",
   "fieldtype": "Section Break",
   "description": "Une ligne par période de congé prévue pour chaque membre de l'équipe."
  },
  {
   "fieldname": "lignes",
   "label": "Lignes",
   "fieldtype": "Table",
   "options": "Planning Conge Equipe Ligne",
   "reqd": 1
  },
  {
   "fieldname": "section_synthese",
   "label": "Synthèse",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "nb_employes",
   "label": "Employés concernés",
   "fieldtype": "Int",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "col_synth",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "total_jours",
   "label": "Total jours planifiés",
   "fieldtype": "Int",
   "read_only": 1
  },
  {
   "fieldname": "section_comment",
   "label": "Commentaires",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "commentaire_chef",
   "label": "Commentaire du Chef",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "col_comment",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "commentaire_rh",
   "label": "Commentaire RH / DG",
   "fieldtype": "Small Text",
   "depends_on": "eval:doc.commentaire_rh"
  },
  {
   "fieldname": "section_workflow",
   "label": "Statut & Approbation",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "statut",
   "label": "Statut",
   "fieldtype": "Select",
   "options": "Brouillon\nEn attente RH\nEn attente DG\nApprouvé\nRejeté",
   "default": "Brouillon",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "read_only": 1
  },
  {
   "fieldname": "col_wf",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "workflow_state",
   "label": "État du Flux",
   "fieldtype": "Data",
   "hidden": 1,
   "read_only": 1
  },
  {
   "fieldname": "section_generated",
   "label": "Plannings générés",
   "fieldtype": "Section Break",
   "depends_on": "eval:doc.plannings_generes"
  },
  {
   "fieldname": "generes",
   "label": "Plannings individuels générés",
   "fieldtype": "Check",
   "read_only": 1,
   "default": 0
  },
  {
   "fieldname": "plannings_generes",
   "label": "Plannings Congé créés",
   "fieldtype": "Small Text",
   "read_only": 1
  },
  {
   "fieldname": "amended_from",
   "label": "Modifié depuis",
   "fieldtype": "Link",
   "options": "Planning Conge Equipe",
   "no_copy": 1,
   "print_hide": 1,
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1,
   "submit": 1, "cancel": 1, "amend": 1, "print": 1, "email": 1, "export": 1, "report": 1, "share": 1
  },
  {
   "role": "HR Manager",
   "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1, "print": 1, "export": 1, "report": 1
  },
  {
   "role": "Responsable RH",
   "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1, "print": 1, "export": 1, "report": 1
  },
  {
   "role": "HR User",
   "read": 1, "write": 1, "create": 1, "submit": 1
  },
  {
   "role": "Directeur Général",
   "read": 1, "write": 1, "submit": 1, "cancel": 1, "print": 1, "export": 1, "report": 1
  },
  {
   "role": "DGA",
   "read": 1, "write": 1, "submit": 1, "print": 1, "report": 1
  },
  {
   "role": "Chef Service",
   "read": 1, "write": 1, "create": 1, "submit": 1, "if_owner": 1
  },
  {
   "role": "Chef Equipe",
   "read": 1, "write": 1, "create": 1, "submit": 1, "if_owner": 1
  },
  {
   "role": "Chef d'Équipe",
   "read": 1, "write": 1, "create": 1, "submit": 1, "if_owner": 1
  },
  {
   "role": "Supérieur Immédiat",
   "read": 1, "write": 1, "create": 1, "submit": 1, "if_owner": 1
  }
 ]
}
