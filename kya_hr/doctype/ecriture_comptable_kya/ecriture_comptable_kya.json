   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Journal (C.j)",
   "reqd": 1
  },
  {
   "fieldname": "numero_piece",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "N° pièce"
  },
  {
   "fieldname": "col_ecr",
   "fieldtype": "Column Break"
  },
  {
