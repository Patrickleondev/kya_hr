{
 "name": "Campagne Conge KYA",
 "module": "KYA HR",
 "doctype": "DocType",
 "custom": 0,
 "engine": "InnoDB",
 "autoname": "format:CAMP-{annee}",
 "title_field": "titre",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "section_def",
   "label": "Définition de la campagne",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "annee",
   "label": "Année",
   "fieldtype": "Int",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Année couverte par la campagne de congés (ex: 2027)"
  },
  {
   "fieldname": "statut",
   "label": "Statut",
   "fieldtype": "Select",
   "options": "Préparée\nOuverte\nClôturée",
   "default": "Préparée",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "col_def",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "date_ouverture",
   "label": "Date d'ouverture",
   "fieldtype": "Date",
   "description": "Début de la période pendant laquelle les chefs saisissent."
  },
  {
   "fieldname": "date_limite",
   "label": "Date limite (échéance)",
   "fieldtype": "Date",
   "in_list_view": 1,
   "description": "Échéance de soumission communiquée aux chefs."
  },
  {
   "fieldname": "section_msg",
   "label": "Communication aux chefs",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "message_chef",
   "label": "Message aux chefs (optionnel)",
   "fieldtype": "Small Text",
   "description": "Ajouté au mail d'invitation envoyé aux chefs d'équipe."
  },
  {
   "fieldname": "titre",
   "label": "Titre",
   "fieldtype": "Data",
   "read_only": 1,
   "hidden": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "email": 1, "export": 1, "report": 1, "share": 1
  },
  {
   "role": "HR Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "export": 1, "report": 1
  },
  {
   "role": "Responsable RH",
   "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "export": 1, "report": 1
  },
  {
   "role": "HR User",
   "read": 1, "write": 1, "create": 1
  },
  {
   "role": "Directeur Général",
   "read": 1, "print": 1, "export": 1, "report": 1
  },
  {
   "role": "DGA",
   "read": 1, "report": 1
  }
 ]
}
