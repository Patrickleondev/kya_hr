{
 "name": "Retour Materiel KYA",
 "module": "KYA HR",
 "doctype": "DocType",
 "is_submittable": 1,
 "custom": 1,
 "autoname": "format:PV-RET-{YYYY}-{#####}",
 "title_field": "objet",
 "search_fields": "objet, date_retour, project, statut",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "section_general",
   "label": "Informations du Retour",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "pv_sortie_origine",
   "label": "PV Sortie d'Origine",
   "fieldtype": "Link",
   "options": "PV Sortie Materiel",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "PV de Sortie initial dont les articles sont retournés au magasin"
  },
  {
   "fieldname": "date_retour",
   "label": "Date du Retour",
   "fieldtype": "Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "col_ref",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "reference",
   "label": "Référence",
   "fieldtype": "Data",
   "default": "KYA-STK-RET-V01",
   "read_only": 1
  },
  {
   "fieldname": "objet",
   "label": "Motif du Retour",
   "fieldtype": "Small Text",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "section_context",
   "label": "Contexte (Projet / Client)",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "project",
   "label": "Projet / Chantier",
   "fieldtype": "Link",
   "options": "Project",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "fetch_from": "pv_sortie_origine.project",
   "fetch_if_empty": 1
  },
  {
   "fieldname": "customer",
   "label": "Client",
   "fieldtype": "Link",
   "options": "Customer",
   "in_standard_filter": 1,
   "fetch_from": "pv_sortie_origine.customer",
   "fetch_if_empty": 1
  },
  {
   "fieldname": "customer_libre",
   "label": "Client (saisie manuelle)",
   "fieldtype": "Data",
   "description": "Si le client n'est pas encore enregistré"
  },
  {
   "fieldname": "section_items",
   "label": "Matériels Retournés",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "items",
   "label": "Liste des Articles Retournés",
   "fieldtype": "Table",
   "options": "Retour Materiel KYA Item",
   "reqd": 1
  },
  {
   "fieldname": "section_signatures",
   "label": "Approbations & Signatures",
   "fieldtype": "Section Break",
   "description": "Circuit : Retourneur → Responsable Magasin"
  },
  {
   "fieldname": "col_retourneur",
   "fieldtype": "Column Break",
   "label": "Retourneur"
  },
  {
   "fieldname": "retourneur_nom",
   "label": "Nom Retourneur",
   "fieldtype": "Data"
  },
  {
   "fieldname": "retourneur_date",
   "label": "Date",
   "fieldtype": "Date"
  },
  {
   "fieldname": "signature_retourneur",
   "label": "Signature Retourneur",
   "fieldtype": "Signature"
  },
  {
   "fieldname": "col_magasin",
   "fieldtype": "Column Break",
   "label": "Responsable Magasin"
  },
  {
   "fieldname": "magasin_nom",
   "label": "Nom Responsable Magasin",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "magasin_date",
   "label": "Date Réception Magasin",
   "fieldtype": "Date",
   "read_only": 1
  },
  {
   "fieldname": "signature_magasin",
   "label": "Signature Magasin",
   "fieldtype": "Signature",
   "read_only": 1
  },
  {
   "fieldname": "section_statut",
   "label": "Statut",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "statut",
   "label": "Statut",
   "fieldtype": "Select",
   "options": "Brouillon\nEn attente Magasin\nApprouvé\nRejeté",
   "default": "Brouillon",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "read_only": 1
  },
  {
   "fieldname": "workflow_state",
   "label": "État du Flux",
   "fieldtype": "Data",
   "hidden": 1,
   "read_only": 1
  },
  {
   "fieldname": "stock_entry",
   "label": "Stock Entry généré",
   "fieldtype": "Link",
   "options": "Stock Entry",
   "read_only": 1,
   "print_hide": 1
  },
  {
   "fieldname": "amended_from",
   "label": "Modifié depuis",
   "fieldtype": "Link",
   "options": "Retour Materiel KYA",
   "no_copy": 1,
   "print_hide": 1,
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1,
   "submit": 1, "cancel": 1, "amend": 1, "print": 1,
   "email": 1, "export": 1, "report": 1, "share": 1
  },
  {
   "role": "Stock Manager",
   "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "amend": 1
  },
  {
   "role": "Stock User",
   "read": 1, "write": 1, "create": 1, "submit": 1
  },
  {
   "role": "Employee",
   "read": 1, "write": 1, "create": 1, "if_owner": 1
  }
 ]
}
