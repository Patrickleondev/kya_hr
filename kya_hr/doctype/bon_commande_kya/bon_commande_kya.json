   "fieldtype": "Data",
   "label": "Délai de livraison"
  },
  {
   "default": "30 jours",
   "fieldname": "validite",
   "fieldtype": "Data",
   "label": "Validité"
  },
  {
   "fieldname": "col_modalites",
   "fieldtype": "Column Break"
