  {
   "default": "100% à la livraison",
   "fieldname": "modalites_paiement",
   "fieldtype": "Data",
   "label": "Modalités de paiement"
  },
  {
   "description": "Coordonnées bancaires / mode de règlement",
   "fieldname": "reglement",
   "fieldtype": "Small Text",
   "label": "Règlement"
  },
  {
   "description": "Le BC est autorisé par le DG OU le DGA. Une seule des deux signatures suffit.",
   "fieldname": "section_signatures",
   "fieldtype": "Section Break",
   "label": "Autorisation (DG ou DGA)"
  },
  {
   "fieldname": "autorise_par_nom",
   "fieldtype": "Data",
   "label": "Autorisé par (nom)"
  },
  {
   "default": "Directeur Général",
   "fieldname": "autorise_par_fonction",
   "fieldtype": "Select",
   "label": "Fonction",
   "options": "\nDirecteur Général\nDirecteur Général Adjoint"
  },
  {
   "fieldname": "signature_dg",
   "fieldtype": "Signature",
   "label": "Signature DG"
  },
  {
   "fieldname": "col_sig",
   "fieldtype": "Column Break"
  },
  {
   "description": "Signature alternative si le DG est indisponible",
   "fieldname": "signature_dga",
   "fieldtype": "Signature",
   "label": "Signature DGA"
  },
  {
   "fieldname": "date_autorisation",
   "fieldtype": "Date",
   "label": "Date d'autorisation"
  },
  {
   "default": 0,
   "fieldname": "cachet",
   "fieldtype": "Check",
   "label": "Cachet apposé"
  },
  {
   "fieldname": "section_statut",
   "fieldtype": "Section Break",
   "label": "Statut"
  },
  {
   "default": "Brouillon",
   "fieldname": "statut",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Statut",
   "options": "Brouillon\nEn attente Visa Audit\nEn attente Autorisation\nÉmis\nEnvoyé Fournisseur\nLivré\nClôturé\nAnnulé"
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Modifié depuis",
   "no_copy": 1,
   "options": "Bon Commande KYA",
   "print_hide": 1,
   "read_only": 1
  }
