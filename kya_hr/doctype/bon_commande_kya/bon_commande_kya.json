{
 "autoname": "format:BC-{YYYY}-{#####}",
 "custom": 1,
 "doctype": "DocType",
 "fields": [
  {
   "fieldname": "section_entete",
   "fieldtype": "Section Break",
   "label": "Identification"
  },
  {
   "description": "ex: O4026/KYA/DG/SMA",
   "fieldname": "numero_bc",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "N° du Bon de Commande",
   "reqd": 1
  },
  {
   "default": "Today",
   "fieldname": "date_bc",
   "fieldtype": "Date",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Date du BC",
   "reqd": 1
  },
  {
   "fieldname": "col_entete",
   "fieldtype": "Column Break"
  },
  {
   "default": "KYA-ACH-BC-V01",
   "fieldname": "reference",
   "fieldtype": "Data",
   "label": "Référence",
   "read_only": 1
  },
  {
   "fieldname": "demande_achat",
   "fieldtype": "Link",
   "in_standard_filter": 1,
   "label": "Demande d'Achat liée",
   "options": "Demande Achat KYA"
  },
  {
   "fieldname": "section_objet",
   "fieldtype": "Section Break",
   "label": "Objet de la commande"
  },
