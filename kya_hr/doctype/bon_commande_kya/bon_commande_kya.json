  {
   "fieldname": "section_articles",
   "fieldtype": "Section Break",
   "label": "Articles commandés"
  },
  {
   "fieldname": "articles",
   "fieldtype": "Table",
   "label": "Articles",
   "options": "Bon Commande KYA Item",
   "reqd": 1
  },
  {
   "fieldname": "section_totaux",
   "fieldtype": "Section Break",
   "label": "Montants"
