   "fieldname": "fournisseur",
   "fieldtype": "Link",
   "label": "Fournisseur (référence)",
   "options": "Supplier"
  },
  {
   "fetch_from": "fournisseur.supplier_name",
   "fetch_if_empty": 1,
   "fieldname": "fournisseur_nom",
   "fieldtype": "Data",
